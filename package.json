{
  "name": "slicewright",
  "version": "0.4.0",
  "description": "Prompt, inspect, and preview nine-slice and three-slice UI art for game engines.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imjlk/slicewright.git"
  },
  "bugs": {
    "url": "https://github.com/imjlk/slicewright/issues"
  },
  "homepage": "https://github.com/imjlk/slicewright#readme",
  "keywords": [
    "nine-slice",
    "9-slice",
    "nine-patch",
    "scale9",
    "phaser",
    "game-ui",
    "sprite"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "bin": {
    "slicewright": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "default": "./dist/playwright.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "slicewright": "ttsx src/cli.ts",
    "check": "ttsc --noEmit",
    "lint": "ttsc --noEmit",
    "format": "ttsc format",
    "fix": "ttsc fix",
    "test": "ttsx test/index.ts",
    "build": "pnpm clean && ttsc -p tsconfig.build.json",
    "examples": "ttsx tools/make-examples.ts",
    "engine:check": "ttsx tools/engine-check.ts",
    "browser:check": "ttsx tools/browser-check.ts",
    "playwright:check": "ttsx tools/playwright-check.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepublishOnly": "pnpm check && pnpm test && pnpm build",
    "sampo:add": "sampo add",
    "sampo:release:dry-run": "sampo release --dry-run"
  },
  "dependencies": {
    "fast-png": "8.0.0",
    "gunshi": "0.37.3",
    "typia": "15.1.0"
  },
  "peerDependencies": {
    "@playwright/test": "^1.64.0",
    "playwright-core": "^1.64.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@ttsc/evidence": "0.30.4",
    "@ttsc/graph": "0.30.4",
    "@ttsc/lint": "0.30.4",
    "@types/node": "^24.0.0",
    "playwright-core": "^1.64.0",
    "ttsc": "0.30.4",
    "typescript": "7.0.2"
  }
}
